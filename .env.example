APP_ENV=development
HTTP_ADDR=:8080
NEXT_PUBLIC_API_URL=http://localhost:8080
DATABASE_URL=postgres://user:password@localhost:5432/school_db?sslmode=disable
TEST_DATABASE_URL=postgres://user:password@localhost:5432/school_db_test?sslmode=disable
REDIS_URL=redis://localhost:6379
OCR_URL=http://localhost:8001
JWT_SECRET=replace-with-at-least-32-random-bytes
CORS_ORIGIN=http://localhost:3000
# 仅当 API 位于可信反向代理之后时设为 true；直接暴露 API 时必须保持 false。
TRUST_PROXY=false
# 启动 API 时自动执行数据库迁移（默认 true）。使用独立迁移账号时可设为 false。
AUTO_MIGRATE=true
# AI 可选配置。留空 AI_API_KEY 时使用内置确定性本地引擎，不发起外部请求。
# AI_BASE_URL 指向 OpenAI 兼容服务的根地址（不含 /chat/completions）。
# 管理员也可在学校设置中配置全校共享模型，学校配置优先于这里的环境变量。
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=45
# 用于加密学校设置中保存的厂商 API Key；留空时回退到 JWT_SECRET。
AI_SETTINGS_SECRET=
# AI 对话附件（图片/PDF/Word）落盘目录。生产环境请挂载持久化卷并纳入备份。
AI_UPLOAD_DIR=./data/ai-uploads
# 默认 false：模型重试与多模型故障转移均失败时返回明确错误，不静默降级本地。
# 设为 true 时允许回退内置本地引擎，并在响应中标注 provider=fallback 与降级原因。
AI_ALLOW_LOCAL_FALLBACK=false
